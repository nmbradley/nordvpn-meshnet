#!/usr/bin/with-contenv bash

# Do nothing if NordVPN isn't available
while [ ! -S /run/nordvpn/nordvpnd.sock ] ; do
  sleep 1
done

# Set the token from file if ENV is not set
[[ -z "${NORDVPN_TOKEN}" ]] && [[ -f "${NORDVPN_TOKENFILE}" ]] && NORDVPN_TOKEN="$(head -n 1 "${NORDVPN_TOKENFILE}")"

# NordVPN 5.x prompts for analytics consent on first use and loops forever
# without a TTY; answer it non-interactively before any other command
printf 'n\n' | nordvpn set analytics off > /dev/null 2>&1

# Make sure the token isn't destroyed on logout
nordvpn logout --persist-token > /dev/null

# Login with token (reuse the saved login if there is one)
if [[ -n ${NORDVPN_TOKEN} ]]; then
  if ! LOGIN_OUT=$(nordvpn login --token "${NORDVPN_TOKEN}" 2>&1); then
    if grep -qi "already logged in" <<< "${LOGIN_OUT}"; then
      echo "Already logged in, reusing saved login."
    else
      echo "Login failed: ${LOGIN_OUT}"
      exit 1
    fi
  fi
else
  echo "No token set."
  exit 1
fi

exit 0
